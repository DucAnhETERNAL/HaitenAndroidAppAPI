@{
    Layout = "Usershared/_UserLayout";
    ViewData["Title"] = "Manga Details";
    var mangaId = ViewData["MangaId"];
}


<style>
    .rating {
        font-size: 24px;
        cursor: pointer;
    }

    .star {
        color: gray;
    }

        .star.selected {
            color: gold;
        }

    .star {
        color: gray;
        font-size: 24px;
        cursor: pointer;
    }

        .star.checked {
            color: gold;
        }

        .rating i {
    color: gray;
}

.rating i.checked {
    color: gold;
}

    .rating .star {
        color: gray;
        font-size: 24px;
        cursor: pointer;
    }

        .rating .star:hover {
            color: lightgray; /* Màu xám nhạt khi hover */
        }

        .rating .star.selected {
            color: gold;
        }

