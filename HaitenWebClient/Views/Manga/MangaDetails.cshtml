<!-- Nhúng jQuery trước khi dùng -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>


<input type="hidden" id="userId" />
<input type="hidden" id="userName" /> <!-- 🆕 Thêm input ẩn userName -->

<script>
    $(document).ready(function () {
        const jwtToken = localStorage.getItem("jwtToken");

        if (!jwtToken) {
            console.error("Không tìm thấy JWT Token. Chuyển hướng đến trang đăng nhập.");
            window.location.href = '/login';
            return;
        }

        $.ajax({
            url: "https://localhost:7016/api/google-login/profile",
            type: "GET",
            headers: {
                Authorization: `Bearer ${jwtToken}`
            },
            success: function (response) {
                if (!response || !response.id || !response.userName) { // 🆕 Kiểm tra userName
                    console.error("Lỗi: API không trả về userId hoặc userName.");
                    window.location.href = '/login';
                    return;
                }

                const userId = response.id;
                const userName = response.userName; // 🆕 Lấy userName

                console.log("✅ User ID:", userId);
                console.log("✅ User Name:", userName);

                // Gán userId & userName vào input ẩn
                $('#userId').val(userId);
                $('#userName').val(userName); // 🆕 Gán userName vào input

                // Hiển thị thông tin lên UI
                $('#userIdDisplay').text("User ID: " + userId);
                $('#userNameDisplay').text("User Name: " + userName); // 🆕 Hiển thị userName
            },
            error: function (jqXHR, textStatus, errorThrown) {
                console.error("Lỗi khi gọi API profile:", textStatus, errorThrown);
                window.location.href = '/login';
            }
        });
    });
</script>




<script>
    $(document).ready(function () {
        const urlParams = new URLSearchParams(window.location.search);
        const userId = urlParams.get("userId"); // Lấy giá trị userId

        console.log("UserId từ URL:", userId);


        const mangaId = @mangaId; // Lấy mangaId từ ViewData
        const jwtToken = localStorage.getItem("jwtToken"); // Lấy JWT Token từ Local Storage

        if (!userId) {
            $("#followBtn").click(function () {
                alert("Vui lòng đăng nhập để theo dõi!");
            });
            return;
        }

        // 🟢 1. Kiểm tra trạng thái `isFavorite` từ API
        $.ajax({
            url: `https://localhost:7016/api/PersonalList/${userId}`,
            type: "GET",
            headers: {
                Authorization: `Bearer ${jwtToken}`
            },
            success: function (response) {
                const manga = response.find(item => item.mangaId === mangaId);
                if (manga && manga.isFavorite === true) {
                    $("#followBtn i").removeClass("fa-heart-o").addClass("fa-heart"); // Trái tim đầy
                    $("#followBtn").attr("data-userMangaListId", manga.id); // Lưu ID vào button
                } else {
                    $("#followBtn i").removeClass("fa-heart").addClass("fa-heart-o"); // Trái tim trống
                }
            },
            error: function () {
                console.error("Lỗi khi lấy danh sách yêu thích.");
            }
        });

        $("#followBtn").click(function (e) {
            e.preventDefault();
            const isFavorite = $("#followBtn i").hasClass("fa-heart");
            const userMangaListId = $("#followBtn").attr("data-userMangaListId"); // Lấy ID từ button

            if (isFavorite) {
                // 🛑 Gọi API remove nếu đang là yêu thích
                $.ajax({
                    url: `https://localhost:7016/api/PersonalList/remove/${userMangaListId}`,
                    type: "DELETE",
                    headers: {
                        Authorization: `Bearer ${jwtToken}`
                    },
                    success: function () {
                        alert("Đã xóa khỏi danh sách yêu thích!");
                        $("#followBtn i").removeClass("fa-heart").addClass("fa-heart-o"); // Đổi icon thành trái tim trống
                        $("#followBtn").removeAttr("data-userMangaListId"); // Xóa ID
                    },
                    error: function () {
                        alert("Có lỗi xảy ra khi xóa !");
                    }
                });
            } else {
                // ✅ Gọi API add nếu chưa yêu thích
                $.ajax({
                    url: "https://localhost:7016/api/PersonalList/add",
                    type: "POST",
                    contentType: "application/json",
                    headers: {
                        Authorization: `Bearer ${jwtToken}`
                    },
                    data: JSON.stringify({
                        userId: userId,
                        mangaId: mangaId,
                        isFavorite: true,
                        AddedAt: new Date().toISOString()

                    }),
                    success: function (response) {
                        alert("Đã thêm vào danh sách yêu thích!");
                        $("#followBtn i").removeClass("fa-heart-o").addClass("fa-heart"); // Đổi icon thành trái tim đầy
                        $("#followBtn").attr("data-userMangaListId", response.id); // Lưu ID mới
                    },
                    error: function () {
                        alert("Có lỗi xảy ra, vui lòng thử lại!");
                    }
                });
            }
        });
    });

    function formatDateTime(input) {
        const date = new Date(input);
        const year = date.getFullYear();
        const month = (date.getMonth() + 1).toString().padStart(2, '0');
        const day = date.getDate().toString().padStart(2, '0');
        const hours = date.getHours().toString().padStart(2, '0');
        const minutes = date.getMinutes().toString().padStart(2, '0');

        return `${year}-${month}-${day} ${hours}:${minutes}`;
    }

    const formattedDate = formatDateTime("2025-04-03T10:18:06.2036252");
    console.log(formattedDate);  // Output: 2025-04-03 10:18


</script>




<script>
    $(document).ready(function () {

        // Sự kiện chọn sao
        $(".star").click(function () {
            var ratingValue = $(this).data("value");

            // Xóa tất cả các lớp "selected" cũ
            $(".star").removeClass("selected");

            // Thêm lớp "selected" vào sao hiện tại và tất cả các sao trước nó
            $(".star").each(function () {
                if ($(this).data("value") <= ratingValue) {
                    $(this).addClass("selected");
                }
            });

            // Cập nhật giá trị đã chọn vào input hidden
            $("#selectedRating").val(ratingValue);
        });

        const mangaId = @mangaId; // Lấy mangaId từ Razor hoặc View

        // 🔹 Gọi API để lấy danh sách đánh giá khi trang tải lên
        function loadReviews() {
            $.ajax({
                url: `https://localhost:7016/api/Rating/${mangaId}`,
                type: "GET",
                contentType: "application/json",
                success: function (response) {
                    $("#reviewList").empty(); // Xóa danh sách cũ trước khi hiển thị mới

                    if (response.length === 0) {
                        $("#reviewList").append("<p>Chưa có đánh giá nào.</p>");
                        return;
                    }

                    // 🔹 Duyệt qua danh sách đánh giá và hiển thị
                    response.forEach(review => {
                        $("#reviewList").append(`
                        <div class="anime__review__item">
                            <div class="anime__review__item__pic">
                                <img src="${review.userAvatar || 'img/anime/review-placeholder.jpg'}" alt=""/>
                            </div>
                            <div class="anime__review__item__text">
                                <h6>${review.userName || 'Ẩn danh'} - <span>${new Date(review.createdAt).toLocaleString()}</span></h6>
                                <div class="rating">${generateStars(review.rating)}</div>
                                <p>${review.comment}</p>
                            </div>
                        </div>
                    `);
                    });
                },
                error: function () {
                    alert("Không thể tải đánh giá. Vui lòng thử lại!");
                }
            });
        }

        // 🔹 Hàm tạo HTML cho số sao
        function generateStars(rating) {
            let starsHtml = "";
            for (let i = 1; i <= 5; i++) {
                starsHtml += `<i class="fa fa-star ${i <= rating ? 'checked' : ''}"></i>`;
            }
            return starsHtml;
        }



        // Gọi API khi trang tải lên
        loadReviews();

        // 🔹 Xử lý khi gửi đánh giá mới
        $("#reviewForm").submit(function (e) {
            e.preventDefault();
            const userId = $("#userId").val();
            const rating = $("#selectedRating").val();
            const comment = $("#commentText").val();
            const jwtToken = localStorage.getItem("jwtToken");

            if (!userId) {
                alert("Vui lòng đăng nhập để đánh giá!");
                return;
            }

            if (rating == 0) {
                alert("Vui lòng chọn số sao!");
                return;
            }

            $.ajax({
                url: "https://localhost:7016/api/Rating/add",
                type: "POST",
                contentType: "application/json",
                headers: {
                    Authorization: `Bearer ${jwtToken}`
                },
            data: JSON.stringify({
                userId: userId,
                mangaId: mangaId,
                rating: rating,
                comment: comment || "No comment",
                createdAt: new Date().toISOString()
            }),
            success: function () {
                alert("Cảm ơn bạn đã đánh giá!");
                loadReviews(); // Cập nhật danh sách đánh giá mới
                $("#commentText").val("");
                $(".star").removeClass("selected");
                $("#selectedRating").val("0");
            },
            error: function () {
                alert("Có lỗi xảy ra, vui lòng thử lại!");
            }
                });
            });
        });
</script>







