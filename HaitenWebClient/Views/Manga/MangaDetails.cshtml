<!-- Nhúng jQuery trước khi dùng -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>


<p id="userIdDisplay" style="color: white;"></p>
<input type="hidden" id="userId" />
<script>
    $(document).ready(function () {
        const jwtToken = localStorage.getItem("jwtToken");

        if (!jwtToken) {
            console.error("Không tìm thấy JWT Token. Chuyển hướng đến trang đăng nhập.");
            window.location.href = '/login';
            return;
        }

        $.ajax({
            url: "https://localhost:7016/api/google-login/profile",
            type: "GET",
            headers: {
                Authorization: `Bearer ${jwtToken}`
            },
        success: function (response) {
            if (!response || !response.id) {
                console.error("Lỗi: API không trả về userId.");
                window.location.href = '/login';
                return;
            }

            const userId = response.id;
            console.log("✅ User ID nhận được:", userId);

            // Gán userId vào input hidden
            $('#userId').val(userId);

            // Hiển thị userId trên UI
            $('#userIdDisplay').text("User ID: " + userId);

            // Load danh sách manga
            loadPersonalMangaList(userId);
        },
        error: function (jqXHR, textStatus, errorThrown) {
            console.error("Lỗi khi gọi API profile:", textStatus, errorThrown);
            window.location.href = '/login';
        }
            });
        });
</script>



<script>
    $(document).ready(function () {
        $("#followBtn").click(function (e) {
            e.preventDefault(); // Ngăn chặn hành vi mặc định của thẻ <a>

            const userId = $("#userId").val(); // Lấy userId từ input hidden
            const mangaId = @mangaId; // Lấy mangaId từ ViewData

            if (!userId) {
                alert("Vui lòng đăng nhập để theo dõi!");
                return;
            }

            const jwtToken = localStorage.getItem("jwtToken"); // Lấy JWT Token từ Local Storage

            $.ajax({
                url: "https://localhost:7016/api/PersonalList/add",
                type: "POST",
                contentType: "application/json",
                headers: {
                    Authorization: `Bearer ${jwtToken}`
                },
            data: JSON.stringify({
                userId: userId,
                mangaId: mangaId,
                isFavorite: true // Truyền thêm isFavorite = true
            }),
            success: function (response) {
                alert("Đã thêm vào danh sách yêu thích!");
                $("#followBtn i").removeClass("fa-heart-o").addClass("fa-heart"); // Đổi icon thành trái tim đầy
            },
            error: function (jqXHR, textStatus, errorThrown) {
                console.error("Lỗi khi thêm vào danh sách yêu thích:", textStatus, errorThrown);
                alert("Có lỗi xảy ra, vui lòng thử lại!");
            }
                    });
                });
            });
</script>



<script>
    $(document).ready(function () {

        // Sự kiện chọn sao
        $(".star").click(function () {
            var ratingValue = $(this).data("value");

            // Xóa tất cả các lớp "selected" cũ
            $(".star").removeClass("selected");

            // Thêm lớp "selected" vào sao hiện tại và tất cả các sao trước nó
            $(".star").each(function () {
                if ($(this).data("value") <= ratingValue) {
                    $(this).addClass("selected");
                }
            });

            // Cập nhật giá trị đã chọn vào input hidden
            $("#selectedRating").val(ratingValue);
        });

        const mangaId = @mangaId; // Lấy mangaId từ Razor hoặc View

        // 🔹 Gọi API để lấy danh sách đánh giá khi trang tải lên
        function loadReviews() {
            $.ajax({
                url: `https://localhost:7016/api/Rating/${mangaId}`,
                type: "GET",
                contentType: "application/json",
                success: function (response) {
                    $("#reviewList").empty(); // Xóa danh sách cũ trước khi hiển thị mới

                    if (response.length === 0) {
                        $("#reviewList").append("<p>Chưa có đánh giá nào.</p>");
                        return;
                    }

                    // Duyệt qua danh sách đánh giá và thêm vào giao diện
                    response.forEach(review => {
                        $("#reviewList").append(`
                            <div class="anime__review__item">
                                <div class="anime__review__item__pic">
                                    <img src="${review.userAvatar || 'img/anime/review-placeholder.jpg'}" alt=""/>
                                </div>
                                <div class="anime__review__item__text">
                                    <h6>${review.userName} - <span>${new Date(review.createdAt).toLocaleString()}</span></h6>
                                    <div class="rating">${generateStars(review.rating)}</div>
                                    <p>${review.comment}</p>
                                </div>
                            </div>
                        `);

                    });
                },
                error: function () {
                    alert("Không thể tải đánh giá. Vui lòng thử lại!");
                }
            });
        }

        // 🔹 Hàm tạo HTML cho số sao
        function generateStars(rating) {
            let starsHtml = "";
            for (let i = 1; i <= 5; i++) {
                starsHtml += `<i class="fa fa-star ${i <= rating ? 'checked' : ''}"></i>`;
            }
            return starsHtml;
        }



        // Gọi API khi trang tải lên
        loadReviews();

        // 🔹 Xử lý khi gửi đánh giá mới
        $("#reviewForm").submit(function (e) {
            e.preventDefault();
            const userId = $("#userId").val();
            const rating = $("#selectedRating").val();
            const comment = $("#commentText").val();
            const jwtToken = localStorage.getItem("jwtToken");

            if (!userId) {
                alert("Vui lòng đăng nhập để đánh giá!");
                return;
            }

            if (rating == 0) {
                alert("Vui lòng chọn số sao!");
                return;
            }

            $.ajax({
                url: "https://localhost:7016/api/Rating/add",
                type: "POST",
                contentType: "application/json",
                headers: {
                    Authorization: `Bearer ${jwtToken}`
                },
            data: JSON.stringify({
                userId: userId,
                mangaId: mangaId,
                rating: rating,
                comment: comment || "No comment",
                createdAt: new Date().toISOString()
            }),
            success: function () {
                alert("Cảm ơn bạn đã đánh giá!");
                loadReviews(); // Cập nhật danh sách đánh giá mới
                $("#commentText").val("");
                $(".star").removeClass("selected");
                $("#selectedRating").val("0");
            },
            error: function () {
                alert("Có lỗi xảy ra, vui lòng thử lại!");
            }
                });
            });
        });
</script>







<!-- Breadcrumb Begin -->
<div class="breadcrumb-option">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="breadcrumb__links"> 
                    <a href="./index.html"><i class="fa fa-home"></i> Home</a>
                    <a href="./categories.html">Categories</a>
                    <span>Romance</span>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Breadcrumb End -->
<!-- Anime Section Begin -->
<section class="anime-details spad">
    <div class="container">
        <div class="anime__details__content">
            <div class="row">
                <div class="col-lg-3">
                    <div class="anime__details__pic set-bg" data-setbg="img/anime/details-pic.jpg">
                        <div class="view"><i class="fa fa-eye"></i> 9141</div>
                    </div>
                </div>
                <div class="col-lg-9">
                    <div class="anime__details__text">
                        <div class="anime__details__title">
                            <h3 style="color: white;">@Model.Title</h3>
                            </div>
                            

                        <p style="color: white;">@Model.Description</p>

                        <div class="anime__details__widget">
                            <div class="row">
                                <div class="col-lg-6 col-md-6">
                                    <ul>
                                        <li><span>Type:</span> @Model.Type</li>
                                        <li><span>Author:</span> @Model.Author</li>
                                        <li>
                                        <span>Genres:</span>
                                            @if (Model.Genres != null && Model.Genres.Count > 0)

                                            {
                                                <ul>
                                                    @foreach (var genre in Model.Genres)

                                                    {
                                                        <li>@genre.Name</li>
                                                    }
                                                </ul>
                                            }

                                            else

                                            {
                                                <p>No genres available</p>
                                            }




                                        
                                        <li><span>Status:</span> @Model.Status</li>
                                    </ul>
                                </div>
                                <div class="col-lg-6 col-md-6">
                                    <ul>
                                        <li><span>Scores:</span> 7.31 / 1,515</li>
                                        <li><span>Rating:</span> 8.5 / 161 times</li>
                                        <li><span>Duration:</span> 24 min/ep</li>
                                        <li><span>Quality:</span> HD</li>
                                        <li><span>Views:</span> 131,541</li>
                                    </ul>
                                </div>
                            </div>
                        </div>

                        <div class="anime__details__btn">
                            <a href="#" class="follow-btn" id="followBtn">
                                <i class="fa fa-heart-o"></i> Follow
                            </a>
                            <a href="#" class="watch-btn">
                                <span>Watch Now</span> <i class="fa fa-angle-right"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>


        <section class="manga-chapters mt-5">
            <div class="container">
                <h3 class="text-center text-white">Danh sách các Chương</h3>
                <ul class="list-group list-group-flush">
                    @foreach (var chap in Model.Chapters)

                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center" style="background-color: #333; color: white;">
                            <a href="@Url.Action("ReaddingMangaText", "Manga", new { chapterId = chap.Id })" class="text-decoration-none text-light">
                                @chap.Name
                            </a>
                            
                        </li>
                    }
                </ul>
            </div>
        </section>

        <div class="row">
            <div class="col-lg-8 col-md-8">
                <div class="anime__details__review">
                    <div class="section-title">
                        <h5>Reviews</h5>
                    </div>
                    <div id="reviewList">
                        <!-- Danh sách đánh giá sẽ được thêm bằng JavaScript -->
                    </div>
                </div>

                <div class="anime__details__form">
                    <div class="section-title">
                        <div id="pagination" style="text-align: center;">
                            <!-- Các nút phân trang sẽ được thêm vào đây -->
                        </div>

                        <h5>Your Review</h5>
                    </div>
                    <form id="reviewForm">
                        <div class="rating" data-rating="${review.rating}">
                            <span class="star" data-value="1">★</span>
                            <span class="star" data-value="2">★</span>
                            <span class="star" data-value="3">★</span>
                            <span class="star" data-value="4">★</span>
                            <span class="star" data-value="5">★</span>
                        </div>
                        <input type="hidden" id="selectedRating" value="0">
                        <textarea id="commentText" placeholder="Your Comment"></textarea>
                        <button type="submit"><i class="fa fa-location-arrow"></i> Review</button>
                    </form>
                </div>
            </div>
        </div>
           
</section>