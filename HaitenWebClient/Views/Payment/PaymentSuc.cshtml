@{
    Layout = "Usershared/_UserLayout";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Thanh toán thành công</title>

    <style>
        .success-container {
            width: 100%;
            max-width: 450px;
            margin: 0 auto;
            padding: 30px;
            background-color: #ffffff;
            border-radius: 10px;
            box-shadow: 0px 5px 15px rgba(0, 0, 0, 0.1);
            text-align: center;
        }

            .success-container h2 {
                color: #4CAF50;
            }

            .success-container p {
                color: #333;
            }

            .success-container button {
                padding: 10px 20px;
                background-color: #007bff;
                color: white;
                border: none;
                border-radius: 5px;
                cursor: pointer;
            }

                .success-container button:hover {
                    background-color: #0056b3;
                }
    </style>
</head>
<body>

    <div class="success-container">
        <h2>Thanh toán thành công!</h2>
        <p>Cảm ơn bạn đã thanh toán. Bạn sẽ được chuyển hướng về trang chính trong vài giây.</p>
        <button onclick="window.location.href='/home'">Quay lại trang chủ</button>
    </div>

    <script>
        // Tự động chuyển hướng về trang chủ sau 5 giây
        setTimeout(function() {
            window.location.href = '/home'; // Chuyển hướng về trang index
        }, 5000); // Chờ 5 giây
    </script>

</body>
</html>
